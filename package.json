{
  "name": "lokal-ide",
  "productName": "Lokal IDE",
  "version": "0.1.0",
  "description": "IDE mit eingebauter lokaler KI (llama.cpp), Terminal, Ports und Devcontainern",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "app": "sh scripts/package-mac.sh",
    "app:linux": "sh scripts/package-linux.sh",
    "postinstall": "node scripts/fix-pty.mjs"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.90.0",
    "node-llama-cpp": "^3.22.2",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "de.lokalide.app",
    "productName": "Lokal IDE",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "THIRD_PARTY_LICENSES.txt"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/node-pty/**",
      "node_modules/@devcontainers/cli/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "IDE mit eingebauter lokaler KI",
      "description": "Code-Editor mit lokalem KI-Assistenten und Coding-Agent auf Basis von llama.cpp (Metal, CUDA, Vulkan, CPU).",
      "artifactName": "Lokal-IDE-${version}-${arch}.${ext}"
    }
  }
}
